# Nunca inclua credenciais reais no GitHub.
OPS_PASSWORD=COLOQUE_UMA_SENHA_FORTE
OPS_SESSION_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_LONGO
OPS_HOST=127.0.0.1
PORT=8080
OPS_DB_PATH=./data/ops.sqlite3
# Configuração para uso ONLINE: exigirá armazenamento persistente de verdade.
# OPS_HOST=0.0.0.0
# OPS_PUBLIC_URL=https://SEU-DOMINIO
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Envia um relatório diário pelo próprio bot, uma vez por dia, às 08h (horário de Brasília).
OPS_REPORT_TIMEZONE=America/Sao_Paulo
OPS_DAILY_REPORT_HOUR=8
# RSS externos podem ser cadastrados diretamente na aba Radar / Oportunidades.
# Identidade do bot comercial; não contém credenciais.
OPS_BOT_USERNAME=Opspulsbot